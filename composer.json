{
    "name": "soyuka/contexts",
    "description": "Behatch contexts",
    "keywords": ["BDD", "Behat", "Symfony", "Context"],
    "type": "library",
    "license": "beerware",

    "require": {
        "php": ">=8.3",
        "behat/behat": "^4.0",
        "behat/mink": "^1.11",
        "friends-of-behat/mink-extension": "^3.0@alpha",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },

    "require-dev": {
        "behat/mink-browserkit-driver": "^2.3",
        "justinrainbow/json-schema": "^6.0",
        "phpunit/phpunit": "^12.5",
        "robertfausk/behat-panther-extension": "^2.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mime": "^7.4 || ^8.0",
        "symfony/property-access": "^7.4 || ^8.0"
    },

    "suggest": {
        "behat/mink-browserkit-driver": "To send HTTP requests without a browser (RestContext, JsonContext, XmlContext)",
        "justinrainbow/json-schema": "To validate JSON against a schema (JsonContext)",
        "robertfausk/behat-panther-extension": "To run browser steps in a real browser (BrowserContext, DebugContext)",
        "symfony/http-client": "Required by the browserkit_http Mink session",
        "symfony/mime": "Required by the browserkit_http Mink session to send request bodies",
        "symfony/property-access": "To read JSON nodes (JsonContext)"
    },

    "conflict": {
        "justinrainbow/json-schema": "<5.3",
        "symfony/property-access": "<6.4"
    },

    "autoload": {
        "psr-4": {
            "Behatch\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Behatch\\Tests\\": "tests/"
        }
    },

    "config": {
        "bin-dir": "bin/"
    },

    "replace": {
        "sanpi/behatch-contexts": "self.version"
    }
}
